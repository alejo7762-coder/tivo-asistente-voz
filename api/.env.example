# Copie este archivo como .env y cambie los valores.
PUERTO=3000

# Clave para firmar las sesiones (JWT). Use un texto largo y aleatorio.
JWT_SECRETO=cambie-esta-clave-por-una-larga-y-aleatoria

# Clave para cifrar datos sensibles en la base de datos (teléfonos, medicamentos, mensajes).
# Genere una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CLAVE_CIFRADO=

# Archivo de la base de datos SQLite
RUTA_BD=./datos/tivo.sqlite

# Días que se conservan los registros de tomas y de diagnóstico (política de retención)
RETENCION_DIAS=90
