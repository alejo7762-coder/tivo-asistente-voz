# Copie este archivo como .env y cambie los valores.

# Dirección de la API de TIVO y token que entrega "npm run crear-dispositivo" (o "npm run semilla")
URL_API=http://localhost:3000/api
TOKEN_DISPOSITIVO=

# Preguntas abiertas con ChatGPT (opcional: sin clave, el asistente sigue funcionando con sus comandos)
OPENAI_API_KEY=
MODELO_IA=gpt-4o-mini

# Entrada: "vosk" (micrófono, reconocimiento local) o "texto" (teclado, para probar en el computador)
ENTRADA_VOZ=texto
RUTA_MODELO_VOSK=./modelos/vosk-model-small-es-0.42
# Índice del micrófono (vacío = el predeterminado). Lista: python3 src/voz/escucha_vosk.py --listar
MICROFONO=

# Salida: "consola" (solo texto), "espeak" (espeak-ng), "piper" (voz más natural) o "sistema" (voz de Windows/macOS)
SALIDA_VOZ=consola
PIPER_MODELO=./modelos/es_MX-claude-high.onnx

# Carpeta con canciones (.mp3, .wav, .ogg) para "pon música"
RUTA_MUSICA=./musica

# Opcional: programa propio que maneja la pantalla o los LED. Recibe dos argumentos: estado y texto.
# Estados: reposo, escuchando, pensando, hablando, aviso, sin_conexion
COMANDO_PANTALLA=
